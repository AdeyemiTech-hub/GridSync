# Copy to .env and fill in. NEVER commit .env or real keys.

# --- Contracts / deploy (Base Sepolia) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
# Address allowed to call postGridHour (the Supabase oracle key's address). Defaults to deployer if empty.
ORACLE_ADDRESS=
# Max gCO2/kWh for an hour to count as "green" (default 150)
GREEN_THRESHOLD_G_CO2_PER_KWH=150
BASESCAN_API_KEY=

# --- Supabase (later) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
